# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

NODE_ENV=development
PORT=3001
# Em produção com Caddy diretamente à frente da API, configure como 1.
TRUST_PROXY_HOPS=0

# Banco PostgreSQL definido no docker-compose.yml.
DATABASE_URL="postgresql://postgres:pass123@localhost:5432/joao_maria?schema=public"

# Origem autorizada pelo CORS.
FRONTEND_URL="http://localhost:5173"

# Configuração dos tokens feita exclusivamente no back-end.
# O front-end não envia estes valores no payload.
JWT_ACCESS_SECRET="substituir-por-um-segredo-longo-e-aleatorio" #alterar
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7
RESET_TOKEN_EXPIRES_MINUTES=30

# Em desenvolvimento local, usar false.
# Em produção com HTTPS, usar true.
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Envio de avisos via Resend. Mantenha a chave apenas neste arquivo local.
# RESEND_FROM deve usar um remetente/domínio verificado na sua conta Resend.
RESEND_API_KEY=""
RESEND_FROM="Associação João Maria <avisos@seudominio.com.br>"
RESEND_REPLY_TO="contato@seudominio.com.br"

# Conta administrativa inicial.
ADMIN_EMAIL="admin@studioadagio.com.br"
ADMIN_PASSWORD="senha-segura" #alterar
ADMIN_NAME="Administradora"

# URL completa do Cloudinary, incluindo API key e API secret; mantenha apenas no back-end.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"