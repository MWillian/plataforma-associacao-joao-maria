generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum NewsPublicationArea {
  STUDIO
  CRAFTS
  AGRICULTURE
}

// LEMBRAR QUE passwordHash É OBRIGATÓRIO

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  passwordHash     String
  role             UserRole  @default(ADMIN)
  active           Boolean   @default(true)
  refreshTokenHash String?
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  emailsSent EmailNotification[]

  @@map("user")
}

model Guardian {
  id       String            @id @default(uuid())
  name     String
  cpf      String            @unique
  phone    String
  email    String            @unique
  students StudentGuardian[]

  @@map("guardian")
}

model Student {
  id          String            @id @default(uuid())
  name        String
  birthDate   DateTime          @map("birth_date") @db.Date
  medicalInfo String?           @map("medical_info") @db.Text
  active      Boolean           @default(true)
  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@map("student")
}

model StudentGuardian {
  id           String @id @default(uuid())
  studentId    String @map("student_id")
  guardianId   String @map("guardian_id")
  relationship String

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@map("student_guardian")
}

model Class {
  id            String              @id @default(uuid())
  name          String
  modality      String
  schedule      String
  capacity      Int
  active        Boolean             @default(true)
  enrollments   Enrollment[]
  notifications EmailNotification[]

  @@map("class")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  classId    String   @map("class_id")
  status     String
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@map("enrollment")
}

model EmailNotification {
  id      String  @id @default(uuid())
  classId String? @map("class_id")

  senderId Int @map("sender_id")

  subject String
  content String   @db.Text
  sentAt  DateTime @default(now()) @map("sent_at")

  class  Class? @relation(fields: [classId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])

  @@map("email_notification")
}

model Product {
  id          String         @id @default(uuid())
  title       String         @unique
  description String?        @db.Text
  category    String
  price       Decimal?       @db.Decimal(10, 2)
  imageUrl    String?        @map("image_url")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]

  @@map("product")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_image")
}

model News {
  id              String              @id @default(uuid())
  title           String
  description     String?             @db.Text
  publicationArea NewsPublicationArea @map("publication_area")
  published       Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  images          NewsImage[]

  @@index([publicationArea, published, createdAt])
  @@map("news")
}

model NewsImage {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId, sortOrder])
  @@map("news_image")
}
